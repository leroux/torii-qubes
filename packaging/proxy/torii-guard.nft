#!/usr/sbin/nft -f
# torii guard: loaded at boot before Qubes' network setup, and never
# changed or removed by the proxy program. Whatever else happens (Qubes
# turns ip_forward on, the program is stopped, crashes or reloads), this
# qube forwards nothing: everything a workload may reach, the program
# relays itself. A drop in any base chain is final, so no other table can
# re-allow what this drops.
#
# The counters are the evidence, kept by the kernel for every packet from
# boot on: `attempts` counts what workloads sent, `forward` what was
# refused forwarding, and `tripwire` any forwarded packet about to leave,
# which must stay 0 (each one is also logged as "torii-guard-tripwire").
table inet torii-guard
delete table inet torii-guard
table inet torii-guard {
	counter attempts {}
	counter forward_dropped {}
	counter tripwire {}
	counter qubes_dropped {}
	counter ipv6_dropped {}

	chain prerouting {
		type filter hook prerouting priority -400; policy accept;
		iifname "vif*" counter name attempts
		# Workloads have no IPv6 behind the proxy: dom0 turns Qubes' ipv6
		# feature off on proxy qubes, and whatever a workload configures for
		# itself is dropped here, before routing.
		iifname "vif*" meta nfproto ipv6 counter name ipv6_dropped drop
	}
	chain forward {
		type filter hook forward priority -400; policy drop;
		counter name forward_dropped drop
	}
	# Forwarded packets carry an input interface; this qube's own do not,
	# except the kernel's IPv6 link-local control messages (neighbour and
	# router discovery, MLD), which carry the interface they are sent on.
	# Link-local and multicast traffic is never forwarded.
	chain postrouting {
		type filter hook postrouting priority -400; policy accept;
		ip6 saddr { ::, fe80::/10 } accept
		ip6 daddr { ff00::/8, fe80::/10 } accept
		meta iif != 0 counter name tripwire log prefix "torii-guard-tripwire " drop
	}
	# This qube never opens connections to other qubes' Qubes addresses.
	# Replies to its own clients leave through vif* and are not affected.
	chain output {
		type filter hook output priority -400; policy accept;
		oifname != "vif*" ip daddr { 10.137.0.0/16, 10.138.0.0/16 } counter name qubes_dropped drop
	}
}
