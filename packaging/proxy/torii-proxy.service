[Unit]
Description=torii proxy program (tailnet identities for this machine's qubes)
# Enabled per proxy qube by dom0: qvm-service <proxy-qube> torii-proxy on
ConditionPathExists=/run/qubes-service/torii-proxy
After=qubes-db.service qubes-network-uplink.service qubes-qrexec-agent.service torii-guard.service
Wants=qubes-db.service
Requires=torii-guard.service

[Service]
# The kernel sizes the connection-tracking table from the memory the qube
# boots with (3072 entries at 400 MB); every routed connection holds one
# for two minutes after it closes, so the default allows about 25 new
# connections a second before packets are dropped. 65536 is what Linux
# gives a desktop with a few GB and OpenWrt a larger router: about 540 new
# connections a second sustained; entries are allocated as used (about
# 20 MB if full).
ExecStartPre=-/usr/sbin/modprobe nf_conntrack
ExecStartPre=-/usr/sbin/sysctl -q -w net.netfilter.nf_conntrack_max=65536
# Config comes from the per-qube features vm-config.torii*, set by dom0.
# The program waits for a valid one and reloads when dom0 changes it.
ExecStart=/usr/lib/torii/torii-proxy run -config qubesdb:torii -install-rules -downstream vif*
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
