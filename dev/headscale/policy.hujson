// The test mesh's policy (machine file ~/torii-test.yaml: mesh test, machine
// m1-test): the same grants the Tailscale test tailnet had. Every tag is owned by the headscale user torii.
{
  "tagOwners": {
    "tag:m1-test":              ["torii@"],
    "tag:m1-test-svc":    ["torii@"],
    "tag:m1-test-job":    ["torii@"],
    "tag:m1-test-routed": ["torii@"],
    "tag:m1-test-egress": ["torii@"],
    "tag:torii-peer":      ["torii@"],
    "tag:torii-exit":      ["torii@"]
  },
  "grants": [
    {"src": ["tag:torii-peer"], "dst": ["tag:m1-test-svc"],    "ip": ["tcp:80"]},
    {"src": ["tag:torii-peer"], "dst": ["tag:m1-test-routed"], "ip": ["tcp:8000"]},
    {"src": ["tag:m1-test-job", "tag:m1-test-routed"], "dst": ["tag:torii-peer"], "ip": ["tcp:7000", "udp:7001"]},
    {"src": ["tag:m1-test-job", "tag:m1-test-routed"], "dst": ["autogroup:internet"], "ip": ["*"]},
    // The egress identity: internet only, through torii-peer or torii-peer2.
    {"src": ["tag:m1-test-egress"], "dst": ["autogroup:internet"], "ip": ["*"]}
  ],
  "autoApprovers": {"exitNode": ["tag:torii-exit"]}
}
